{
  "swagger": "2.0",
  "info": {
    "title": "CSE341 Project API",
    "description": "REST API for contacts and temples (MongoDB)",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "tags": [
    {
      "name": "Contacts",
      "description": "Contact records in MongoDB"
    },
    {
      "name": "Temples",
      "description": "Temple records in MongoDB"
    }
  ],
  "schemes": [
    "http"
  ],
  "paths": {
    "/contacts/": {
      "get": {
        "description": "Returns every contact document from the contacts collection.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "List of contacts"
          },
          "500": {
            "description": "Server error"
          }
        },
        "tags": [
          "Contacts"
        ],
        "summary": "Get all contacts"
      },
      "post": {
        "description": "Creates a new contact. firstName, lastName, email, favoriteColor, and birthday are required.",
        "responses": {
          "201": {
            "description": "Contact created. Response body contains the new contact id."
          },
          "400": {
            "description": "Missing required field"
          },
          "500": {
            "description": "Server error"
          }
        },
        "tags": [
          "Contacts"
        ],
        "summary": "Create a contact",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Contact"
            }
          }
        ],
        "produces": [
          "application/json"
        ]
      }
    },
    "/contacts/{id}": {
      "get": {
        "description": "Returns a single contact by MongoDB ObjectId.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId (24 hex characters)"
          }
        ],
        "responses": {
          "200": {
            "description": "Contact found"
          },
          "400": {
            "description": "Invalid ObjectId"
          },
          "404": {
            "description": "Contact not found"
          },
          "500": {
            "description": "Server error"
          }
        },
        "tags": [
          "Contacts"
        ],
        "summary": "Get one contact by id"
      },
      "put": {
        "description": "Updates an existing contact by MongoDB ObjectId. All fields are required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId (24 hex characters)"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Contact"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Contact updated successfully"
          },
          "400": {
            "description": "Invalid ObjectId or missing required field"
          },
          "404": {
            "description": "Contact not found"
          },
          "500": {
            "description": "Server error"
          }
        },
        "tags": [
          "Contacts"
        ],
        "summary": "Update a contact",
        "produces": [
          "application/json"
        ]
      },
      "delete": {
        "description": "Deletes an existing contact by MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId (24 hex characters)"
          }
        ],
        "responses": {
          "204": {
            "description": "Contact deleted successfully"
          },
          "400": {
            "description": "Invalid ObjectId"
          },
          "404": {
            "description": "Contact not found"
          },
          "500": {
            "description": "Server error"
          }
        },
        "tags": [
          "Contacts"
        ],
        "summary": "Delete a contact",
        "produces": [
          "application/json"
        ]
      }
    },
    "/temples/": {
      "get": {
        "description": "Returns every temple document from the temples collection.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "List of temples"
          },
          "500": {
            "description": "Server error"
          }
        },
        "tags": [
          "Temples"
        ],
        "summary": "Get all temples"
      }
    },
    "/temples/{id}": {
      "get": {
        "description": "Returns a single temple by MongoDB ObjectId.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId (24 hex characters)"
          }
        ],
        "responses": {
          "200": {
            "description": "Temple found"
          },
          "400": {
            "description": "Invalid ObjectId"
          },
          "404": {
            "description": "Temple not found"
          },
          "500": {
            "description": "Server error"
          }
        },
        "tags": [
          "Temples"
        ],
        "summary": "Get one temple by id"
      }
    }
  },
  "definitions": {
    "Contact": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "email",
        "favoriteColor",
        "birthday"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "example": "Ada"
        },
        "lastName": {
          "type": "string",
          "example": "Lovelace"
        },
        "email": {
          "type": "string",
          "example": "ada@example.com"
        },
        "favoriteColor": {
          "type": "string",
          "example": "blue"
        },
        "birthday": {
          "type": "string",
          "example": "1815-12-10"
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "Contact not found"
        }
      }
    }
  }
}